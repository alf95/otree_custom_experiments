# oTree Environment Variables
# Copy this file to .env and configure your environment variables

# Admin Configuration
OTREE_ADMIN_PASSWORD=

# Bot Configuration
USE_BOT_UG=False

# Database Configuration (PostgreSQL)
# Uncomment and configure these when using PostgreSQL in production
# DATABASE_URL=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=otree_db
# POSTGRES_USER=otree_user
# POSTGRES_PASSWORD=

# Security
SECRET_KEY=

# Production Settings
# OTREE_PRODUCTION=1
# OTREE_AUTH_LEVEL=DEMO

# Sentry (Error Tracking)
# SENTRY_DSN=
